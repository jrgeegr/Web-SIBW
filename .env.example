# ==============================================================================
# ENTORNO DE EJEMPLO - CONFIGURACIÓN LOCAL DE DOCKER (LAMP STACK)
# Copia este archivo como '.env' en la raíz y ajusta tus valores locales.
# ==============================================================================

# Identificador único para los contenedores de este proyecto
COMPOSE_PROJECT_NAME=sibw-practica5

# Versiones de servicios
PHPVERSION=php84
DATABASE=mysql8

# Rutas del sistema de archivos interno
DOCUMENT_ROOT=./www
APACHE_DOCUMENT_ROOT=/var/www/html
VHOSTS_DIR=./config/vhosts
APACHE_LOG_DIR=./logs/apache2
PHP_INI=./config/php/php.ini
SSL_DIR=./config/ssl

# Configuración PHPMyAdmin
UPLOAD_LIMIT=512M
MEMORY_LIMIT=512M

# Depuración remota con Xdebug
XDEBUG_LOG_DIR=./logs/xdebug
XDEBUG_PORT=9003

# Rutas de almacenamiento de persistencia para la Base de Datos
MYSQL_INITDB_DIR=./config/initdb
MYSQL_DATA_DIR=./data/mysql
MYSQL_LOG_DIR=./logs/mysql
MYSQL_CNF=./config/mysql/my.cnf

# ==============================================================================
# MAPEADO DE PUERTOS DE LA MÁQUINA ANFITRIONA (HOST)
# Cambia el puerto de la izquierda si entra en conflicto con otros servicios locales
# ==============================================================================
HOST_MACHINE_UNSECURE_HOST_PORT=8081
HOST_MACHINE_SECURE_HOST_PORT=4433
HOST_MACHINE_MYSQL_PORT=3307
HOST_MACHINE_PMA_PORT=8082
HOST_MACHINE_PMA_SECURE_PORT=8444
HOST_MACHINE_REDIS_PORT=6380

# ==============================================================================
# CREDENCIALES DE ACCESO A MYSQL (¡CÁMBIALAS EN TU .ENV PRIVADO!)
# ==============================================================================
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=sibw_db
MYSQL_USER=sibw_user
MYSQL_PASSWORD=change_this_user_password